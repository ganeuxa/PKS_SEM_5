<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache POI (экспорт в Excel) пишет служебные сообщения через Log4j 2.
  Выводим только ошибки, чтобы не засорять консольное меню.
-->
<Configuration status="OFF">
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
