<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Вкладка «Заявки на тест-драйв»: панель действий, поиск/фильтры/сортировка, таблица и карточка заявки -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.autosalon.controller.RequestsController"
      styleClass="tab-content" spacing="10">

    <!-- Действия с заявками -->
    <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
        <Button text="Добавить" onAction="#handleAdd" styleClass="button-primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#handleEdit"/>
        <Button fx:id="statusButton" text="Сменить статус" onAction="#handleChangeStatus"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#handleDelete" styleClass="button-danger"/>
        <Separator orientation="VERTICAL"/>
        <Button text="Обновить" onAction="#handleRefresh"/>
        <Button text="Экспорт в CSV" onAction="#handleExport"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
    </HBox>

    <!-- Поиск, фильтры и сортировка -->
    <VBox styleClass="filter-panel" spacing="8">
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" prefWidth="320"
                       promptText="Поиск: ФИО, телефон, марка, модель, VIN, комментарий"/>
            <ComboBox fx:id="statusFilter" prefWidth="170"/>
            <ComboBox fx:id="brandFilter" prefWidth="140"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Период с"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="130"/>
                <Label text="по"/>
                <DatePicker fx:id="toDatePicker" prefWidth="130"/>
            </HBox>
            <CheckBox fx:id="upcomingOnlyCheck" text="Только предстоящие"/>
            <Button text="Сбросить фильтры" onAction="#handleResetFilters" styleClass="button-link"/>
        </FlowPane>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Сортировка:"/>
            <ComboBox fx:id="sortBox" prefWidth="320"/>
            <CheckBox fx:id="descendingCheck" text="По убыванию"/>
            <Label text="или щёлкните по заголовку столбца (Shift+щелчок — по нескольким)" styleClass="muted"/>
        </HBox>
        <Label fx:id="filterErrorLabel" styleClass="form-error" wrapText="true"/>
    </VBox>

    <SplitPane dividerPositions="0.72" VBox.vgrow="ALWAYS">
        <TableView fx:id="requestTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Нет заявок, подходящих под условия поиска и фильтры"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="idColumn" text="№" prefWidth="50" styleClass="column-number"/>
                <TableColumn fx:id="scheduledColumn" text="Дата и время" prefWidth="130"/>
                <TableColumn fx:id="durationColumn" text="Мин" prefWidth="55" styleClass="column-number"/>
                <TableColumn fx:id="clientColumn" text="Клиент" prefWidth="220"/>
                <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="115"/>
                <TableColumn fx:id="carColumn" text="Автомобиль" prefWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="130"/>
                <TableColumn fx:id="createdColumn" text="Создана" prefWidth="130"/>
            </columns>
        </TableView>

        <!-- Карточка выбранной заявки: связанные клиент и автомобиль -->
        <ScrollPane fitToWidth="true" styleClass="details-scroll">
            <VBox styleClass="details-panel" spacing="10">
                <Label fx:id="detailsTitle" styleClass="details-title"/>
                <GridPane hgap="8" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Клиент" styleClass="details-key" GridPane.rowIndex="0"/>
                    <Label fx:id="detailsClient" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Автомобиль" styleClass="details-key" GridPane.rowIndex="1"/>
                    <Label fx:id="detailsCar" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Время" styleClass="details-key" GridPane.rowIndex="2"/>
                    <Label fx:id="detailsSchedule" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Статус" styleClass="details-key" GridPane.rowIndex="3"/>
                    <Label fx:id="detailsStatus" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Комментарий" styleClass="details-key" GridPane.rowIndex="4"/>
                    <Label fx:id="detailsComment" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="История" styleClass="details-key" GridPane.rowIndex="5"/>
                    <Label fx:id="detailsHistory" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>
        </ScrollPane>
    </SplitPane>
</VBox>
