<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Форма заявки на тест-драйв: клиент и автомобиль выбираются из списков, а не вводятся по ID -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.autosalon.controller.RequestFormController"
      styleClass="form" spacing="12" prefWidth="560">
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Клиент *" GridPane.rowIndex="0"/>
        <ComboBox fx:id="clientBox" maxWidth="Infinity" promptText="Выберите клиента"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Автомобиль *" GridPane.rowIndex="1"/>
        <ComboBox fx:id="carBox" maxWidth="Infinity" promptText="Выберите автомобиль (только «В наличии»)"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Дата и время *" GridPane.rowIndex="2"/>
        <HBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <DatePicker fx:id="datePicker" prefWidth="150"/>
            <ComboBox fx:id="timeBox" editable="true" prefWidth="100" promptText="ЧЧ:ММ"/>
        </HBox>

        <Label text="Длительность, мин *" GridPane.rowIndex="3"/>
        <TextField fx:id="durationField" maxWidth="100" promptText="15–120"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Комментарий" GridPane.rowIndex="4" GridPane.valignment="TOP"/>
        <TextArea fx:id="commentArea" prefRowCount="3" wrapText="true" promptText="Необязательно, до 500 символов"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="rulesLabel" styleClass="hint" wrapText="true"/>
    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true" maxWidth="Infinity"/>
</VBox>
